# Neon PostgreSQL Connection String
# Get from: https://console.neon.tech → Project → Connection Details
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/madhi?sslmode=require"

# API Key for /api/sync endpoint
# Generate strong key: openssl rand -hex 32
# Frontend sends this as X-Api-Key header
SYNC_API_KEY="change-me-to-a-strong-random-key-at-least-32-chars"